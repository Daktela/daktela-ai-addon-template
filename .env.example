# Copy to .env and adjust. Every variable here has a working default, so an
# empty .env (or no .env at all) is a valid configuration.

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Comma-separated list of accepted X-Api-Key values. Bot-platform must send one
# of these on every request. When unset, the SDK accepts the single key
# "default" - convenient locally, never acceptable in production.
# API_KEYS=change-me,another-key

# ---------------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------------
# Which surface this process exposes:
#   full  (default) - modules plus the React configuration page
#   basic           - modules only; no configuration page, and deliberately no
#                     GET /instance-configured, because a 409 there would block
#                     activation and nothing could ever clear it.
# An unrecognised value refuses to start. See server/profile.py.
# ADDON_PROFILE=full

# ---------------------------------------------------------------------------
# Addon identity
# ---------------------------------------------------------------------------
# What the platform shows and files this addon under. The defaults live in
# server/identity.py - edit them there when you fork. Override here when one
# image serves more than one environment.
#
# ADDON_CODE is the stable identifier. Change it once, when you fork; never
# afterwards, because the platform files every activation and every module
# against it.
# ADDON_CODE=example
# ADDON_NAME=Example Addon
# ADDON_DESCRIPTION=Starter template showing how to build a Daktela AI addon
# ADDON_VERSION=1.0.0
# ADDON_AUTHOR=Your Company
# ADDON_FA_ICON=puzzle-piece
# Your own icon as a full data URI; used instead of ADDON_FA_ICON when set.
# Long to paste here - server/identity.py is the better home for it.
# ADDON_BASE64_ICON=data:image/png;base64,iVBORw0KGgo...
# ADDON_COLOR=#2c6fbb

# The public URL this addon is reachable at. Used when generating the manifest
# signature. Only matters for first-party (signed) addons.
# ADDON_URL=https://addon.example.com

# Set when a reverse proxy serves the addon under a path prefix.
# ROOT_PATH=/addons/example

# ---------------------------------------------------------------------------
# Settings storage - level 1 (default): no database
# ---------------------------------------------------------------------------
# Force a backend instead of auto-detecting from the db_* block: json | postgres
# SETTINGS_STORE=json

# Mirror the in-memory settings to a file so they survive a restart.
# Leave unset for pure in-memory storage.
# ADDON_SETTINGS_FILE=./.addon-settings.json

# ---------------------------------------------------------------------------
# Settings storage - level 2: Postgres (docs/11-persistence.md)
# ---------------------------------------------------------------------------
# Uncomment the whole block to switch the addon to Postgres. These values match
# docker-db/docker-compose.yaml.
# db_host=localhost
# db_port=5442
# db_name=addon_db
# db_username=addon_user
# db_password=addon_password

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Port the backend listens on; the frontend dev server proxies /api to it.
BACKEND_PORT=8000
